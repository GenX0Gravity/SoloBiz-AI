# ==============================================================================
# SoloBiz AI — Environment Configuration Example
# Copy this file to .env and adjust variables as desired.
# ==============================================================================

# Application Server
APP_HOST=127.0.0.1
APP_PORT=8000

# Ollama Local AI Inference
OLLAMA_HOST=http://localhost:11434
# Choose your preferred local open-weight model:
# Examples: llama3.2:3b, qwen2.5:3b, mistral:7b, phi3:mini
OLLAMA_MODEL=llama3.2:latest
OLLAMA_TIMEOUT=45.0

# Storage Locations
DATABASE_NAME=solobiz.db
UPLOAD_DIR=uploads
DATA_DIR=data

# File Upload Limits (in Megabytes)
MAX_UPLOAD_SIZE_MB=15
