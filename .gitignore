# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments
venv/
env/
ENV/
.venv/

# Environment Variables & Secrets (NEVER COMMIT)
.env
.env.*
!.env.example

# Local SQLite Database (Local-first privacy - keep schema clean)
data/*
!data/.gitkeep
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# User Uploaded Invoices and Receipts
uploads/*
!uploads/.gitkeep

# Testing and Coverage
.pytest_cache/
.coverage
htmlcov/

# Logs and databases
*.log

# OS & IDE metadata
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Distribution / Packaging
build/
dist/
*.egg-info/
